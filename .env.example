# Folder on this machine that Docscout may read (mounted read-only).
DOCS_DIR=/home/you/Documents

# Port on localhost for the web UI.
PORT=8080

# Small local LLM for summaries (any Ollama model name). More can be
# downloaded from the Models dialog in the UI.
SUMMARY_MODEL=qwen2.5:1.5b

# Embedding model (fastembed / ONNX). Changing it re-indexes every project.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# Defaults offered when creating a project.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
